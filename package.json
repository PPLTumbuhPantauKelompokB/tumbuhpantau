{
  "name": "tumbuhpantau",
  "version": "0.1.0",
  "private": true,
  "description": "Starter monorepo TumbuhPantau (React + Express)",
  "workspaces": ["frontend", "backend"],
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
